# Copie este arquivo para ".env" (ele NÃO vai para o GitHub) e ajuste.

# ---- Desenvolvimento local ----
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Produção (deixe DJANGO_DEBUG=0 ou apague a linha acima) ----
# DJANGO_SECRET_KEY=cole-uma-chave-aleatoria-forte
# DJANGO_ALLOWED_HOSTS=seudominio.com,www.seudominio.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seudominio.com,https://www.seudominio.com
# DJANGO_BEHIND_PROXY=1

# ---- PostgreSQL (opcional; sem isso usa SQLite) ----
# POSTGRES_DB=nome_do_banco
# POSTGRES_USER=usuario
# POSTGRES_PASSWORD=senha
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
